{
    "version": 3,
    "configurePresets": [
        {
            "name": "default",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "toolchainFile": "${sourceDir}/cmake/gcc-arm-none-eabi.cmake",
            "cacheVariables": {}
        },
        {
            "name": "Debug",
            "inherits": "default",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "Release",
            "inherits": "default",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "Debug-BareMetal",
            "inherits": "default",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "BARE_METAL": "ON"
            }
        },
        {
            "name": "Release-BareMetal",
            "inherits": "default",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "BARE_METAL": "ON"
            }
        },
        {
            "name": "Factory",
            "inherits": "default",
            "displayName": "Factory (bench only: FPGA programming + safety overrides compiled in)",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "OW_FACTORY_PROGRAMMING": "ON"
            }
        },
        {
            "name": "Factory-BareMetal",
            "inherits": "default",
            "displayName": "Factory bare-metal (bench only)",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "OW_FACTORY_PROGRAMMING": "ON",
                "BARE_METAL": "ON"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "Debug",
            "configurePreset": "Debug"
        },
        {
            "name": "Release",
            "configurePreset": "Release"
        },
        {
            "name": "Debug-BareMetal",
            "configurePreset": "Debug-BareMetal"
        },
        {
            "name": "Release-BareMetal",
            "configurePreset": "Release-BareMetal"
        },
        {
            "name": "Factory",
            "configurePreset": "Factory"
        },
        {
            "name": "Factory-BareMetal",
            "configurePreset": "Factory-BareMetal"
        }
    ]
}
